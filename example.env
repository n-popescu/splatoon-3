# ---------------------------------------------------------------------------
# splatoon-3 (Nextendo Network / NPLN) — example configuration
#
# Copy to .env and edit. NOTHING here is a real address or a real secret.
# Every value can also be supplied as a real environment variable, which always
# wins over this file.
# ---------------------------------------------------------------------------

# ---- Tenant ---------------------------------------------------------------
# Splatoon 3's NPLN tenant. The console reaches
#   https://t-dce9377b-lp1.lp1.t.npln.srv.nintendo.net
# and sends this id in the mandatory npln-tenant-id metadata field.
NPLN_TENANT_ID=t-dce9377b-lp1
# Splatoon 3's title id, reported to nextendo-account as the game a player is in.
NPLN_APP_ID=0100c2500fc20000

# ---- Listeners ------------------------------------------------------------
# gRPC/HTTP2 + TLS. Put it behind sni-router to share :443 with the NEX games.
NPLN_LISTEN_ADDR=:443
CERT_FILE=/certs/cert.pem
KEY_FILE=/certs/key.pem
# Local testing only: serve plaintext h2c. A console always requires TLS.
#NPLN_DISABLE_TLS=1

# Plain HTTP: /api/stats + /healthz for the dashboard, /ugc/* for attachments.
# PRIVATE NETWORK ONLY. Fleet convention is DASH_PORT (8082 mk8, 8083 s2,
# 8084 ssbu, 8085 dashboard, 8086 acnh, 8087 minecraft) — so 8088 here.
DASH_PORT=8088
# Full address instead, if you want to bind one interface. Wins over DASH_PORT.
#NPLN_HTTP_ADDR=127.0.0.1:8088
# Required to read /api/stats (it lists players, PIDs and IP addresses).
DASH_TOKEN=change-me

# ---- nextendo-account -----------------------------------------------------
NEXTENDO_ACCOUNT_URL=http://nextendo-account:8080
# Lets this server call the account server's /internal/* control plane.
NEXTENDO_INTERNAL_KEY=change-me
# MUST be byte-identical to nextendo-account's secret: it verifies the "nx2."
# account binding AND derives the NPLN user ids the friend graph is keyed by.
# A mismatch does not fail loudly — it silently empties every friend list.
NEXTENDO_SECRET=change-me
# Alternative to the above: the shared hex key file (same as the NEX servers).
#NEXTENDO_SECRET_FILE=nextendo_secret.key

# Refuse any login that cannot be tied to a Nextendo account (fail-closed).
NEXTENDO_REQUIRE_ACCOUNT=1
# Also demand the cryptographic binding (the "nnex" nx2 claim the emulator adds).
# A retail CFW Switch cannot provide it, so keep this off for mixed deployments.
NEXTENDO_REQUIRE_SIGNED_TOKEN=0
# Verify the BAAS id_token's RS256 signature against the signer's key.
#NPLN_VERIFY_ID_TOKEN=1
#BAAS_SIGNING_KEY=/app/baas_signing_key.pem

# Revoke leaked "nx2." tokens by configuration instead of a code change, the same
# way every other Nextendo server does (revoked.go). Payloads are the DECODED
# middle segment: "pid.username.expiry", separated by commas/semicolons/newlines.
#NEXTENDO_REVOKED_TOKENS=
#NEXTENDO_REVOKED_TOKENS_FILE=revoked_tokens.txt

# ---- Storage --------------------------------------------------------------
# Cloud saves, records, documents, the token signing key, matchmaking.json.
NPLN_DATA_DIR=data
# The rotation. See docs/SCHEDULE.md; start from schedule.example.json.
NPLN_SCHEDULE_FILE=schedule.json

# ---- Behind sni-router ----------------------------------------------------
# Read the real client IP from the PROXY v1 header the router prepends. Same
# variable as the NEX servers. Turn it on together with SNI_SEND_PROXY_PROTOCOL=1
# on sni-router — and note that with the router sending headers, a server that
# does NOT parse them fails every TLS handshake.
#NEXTENDO_PROXY_PROTOCOL=1

# How long a player with no RPC still counts as playing. MUST match
# nextendo-account's value: it is the threshold on both ends of the "one place at
# a time" gate. Bare seconds (fleet style) or a Go duration.
#NEXTENDO_GHOST_IDLE_SECONDS=900

# Caps one received message. Fleet-wide knob; 8 MiB here by default (cloud saves
# and replay uploads are the only large payloads).
#NEXTENDO_MAX_MESSAGE_BYTES=8388608

# ---- NAT traversal (ICE) --------------------------------------------------
# Splatoon 3 asks NPLN for STUN/TURN instead of running the Pia NAT check, so
# nextendo-nncs is NOT used by this game. Without a STUN server, matches will
# not connect (AllocateIceServerSet fails loudly rather than silently).
# Unset, these default to NEXTENDO_HOST — the fleet's one public-address
# variable — so setting that for the deployment is enough.
NPLN_STUN_HOST=SERVER_IP
NPLN_STUN_PORT=3478
NPLN_TURN_HOST=SERVER_IP
NPLN_TURN_PORT=3478
# coturn REST-API secret: credentials become time-limited and per-user, and
# nothing static is shipped to a client. Must match coturn's static-auth-secret.
NPLN_TURN_SECRET=change-me
#NPLN_TURN_USER=
#NPLN_TURN_PASSWORD=
NPLN_TURN_CRED_TTL=1h
# Endpoints the client pings to fill its latency data:
#   name@region=host:port/proto,...
#NPLN_LATENCY_SERVERS=eu1@eu=SERVER_IP:10000/udp

# ---- Matchmaking ----------------------------------------------------------
# How long a partially-filled room keeps waiting for more players.
NPLN_MATCH_WINDOW=20s
# After which a ticket fails cleanly (the game says "no players found").
NPLN_MATCH_TIMEOUT=3m
# Fallback player counts for a config not described in data/matchmaking.json.
# The real per-mode counts belong in that file — see docs/MATCHMAKING.md.
NPLN_MATCH_MIN_PLAYERS=2
NPLN_MATCH_MAX_PLAYERS=8
# A room whose host stops calling SyncGameSession is reaped after this.
NPLN_SESSION_TTL=2m

# ---- Presence -------------------------------------------------------------
# How often the set of players in Splatoon 3 is pushed to nextendo-account, so
# friends see "playing Splatoon 3" everywhere.
NPLN_PRESENCE_INTERVAL=30s
# A player who stops keeping alive is dropped after this.
NPLN_PRESENCE_TTL=90s
# How often an open friends/presence stream re-reads the friend graph.
NPLN_FRIENDS_POLL=15s

# ---- User content ---------------------------------------------------------
# Public prefix of the /ugc/* endpoints (must be reachable BY THE CONSOLE).
# Unset disables attachments, and the server says so when a client asks.
#NPLN_ATTACHMENT_BASE_URL=http://SERVER_IP:8087

# ---- Maintenance ----------------------------------------------------------
# While the window is active, every RPC answers UNAVAILABLE_UNDER_MAINTENANCE
# and the game shows its own maintenance screen instead of an error.
#NPLN_MAINTENANCE_START=2026-08-20T02:00:00Z
#NPLN_MAINTENANCE_END=2026-08-20T04:00:00Z

# ---- Diagnostics ----------------------------------------------------------
# Log every request and response as JSON. Essential for bring-up, far too
# chatty for a live deployment.
NPLN_LOG_BODIES=0
# Log the method and a hexdump of any RPC this server does not implement.
NPLN_LOG_UNKNOWN=1
