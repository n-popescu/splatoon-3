+	// consequence is that a closed connection keeps being written to — the retransmit loop
+	// and the fragment pacer both test it to decide whether to stop.
+	state atomic.Int32
 	mu    sync.Mutex
 
 	// lastSeen : date (UnixNano) du DERNIER paquet reçu de ce client. Sans elle, rien ne
@@ -323,7 +328,7 @@ func (c *Connection) NATBehaviour() (natMap, natFilter uint32) {
 // NewConnection creates a connection whose outbound packets are written via send
 // (one call per PRUDP packet — one WebSocket binary frame).
 func NewConnection(e *Endpoint, remoteAddr string, send func([]byte)) *Connection {
-	return &Connection{
+	c := &Connection{
 		Endpoint:    e,
 		Settings:    e.Settings,
 		RemoteAddr:  remoteAddr,
@@ -331,8 +336,9 @@ func NewConnection(e *Endpoint, remoteAddr string, send func([]byte)) *Connectio
 		outReliable: 1,
 		outPing:     1,
 		pending:     map[uint16][]byte{},
-		state:       stateConnecting,
 	}
+	c.state.Store(stateConnecting)
+	return c
 }
 
 // Feed processes raw bytes from the transport (0+ complete packets, buffering a
@@ -445,7 +451,7 @@ func (c *Connection) processCONNECT(p *Packet) {
 	}
 	c.send(EncodePacket(ack))
 
-	c.state = stateConnected
+	c.state.Store(stateConnected)
 	c.Endpoint.registerConnection(c)
 	go c.retransmitLoop() // re-send unacked reliable packets (large-payload reliability)
 	if c.Endpoint.OnConnect != nil {
@@ -633,7 +639,7 @@ func (c *Connection) sendData(data []byte) {
 		fragmentID := uint8(1)
 		rest := data
 		for {
-			if c.state == stateClosed {
+			if c.state.Load() == stateClosed {
 				return
 			}
 			chunk := rest
@@ -694,10 +700,20 @@ func (c *Connection) sendOneFragment(chunk []byte, fragmentID uint8) {
 
 // ackPackets removes acknowledged sequence ids from the pending pool. A base id acks
 // everything up to and including it; extra ids are acked individually.
+// The comparison is WINDOW-RELATIVE, not `pid <= base`. Sequence ids are 16 bits and
+// outReliable wraps: a long session (a lobby that stays up for hours, an ACNH visit, a
+// 13-fragment DataStore payload per request) passes 65535 and starts again at 0. With a
+// plain <= comparison, everything still pending from before the wrap compares GREATER
+// than every id after it, so it is never acknowledged — retransmitLoop then re-sends
+// those packets every 2 s for the rest of the connection, the pending map never shrinks,
+// and the console keeps receiving duplicates of messages it already processed.
+//
+// int16(pid-base) <= 0 treats the id space as a circle and asks "is pid at or behind
+// base?", which is the standard sequence-number comparison and is wrap-safe.
 func (c *Connection) ackPackets(base uint16, extra []uint16) {
 	c.pendingMu.Lock()
 	for pid := range c.pending {
-		if pid <= base {
+		if int16(pid-base) <= 0 {
 			delete(c.pending, pid)
 		}
 	}
@@ -715,7 +731,7 @@ func (c *Connection) retransmitLoop() {
 	ticker := time.NewTicker(retransmitInterval)
 	defer ticker.Stop()
 	for range ticker.C {
-		if c.state == stateClosed {
+		if c.state.Load() == stateClosed {
 			return
 		}
 		c.pendingMu.Lock()
@@ -749,10 +765,14 @@ func (c *Connection) sendAck(p *Packet) {
 }
 
 func (c *Connection) close() {
-	if c.state == stateClosed {
+	// CompareAndSwap, not test-then-set: the transport closing the socket and the receive
+	// goroutine handling a DISCONNECT can race, and OnDisconnect must run exactly ONCE —
+	// it drops the player's lobbies, so running it twice removes a gathering a reconnecting
+	// player has just created.
+	if !c.state.CompareAndSwap(stateConnected, stateClosed) &&
+		!c.state.CompareAndSwap(stateConnecting, stateClosed) {
 		return
 	}
-	c.state = stateClosed
 	c.Endpoint.unregisterConnection(c)
 	if c.Endpoint.OnDisconnect != nil {
 		c.Endpoint.OnDisconnect(c)
