From f376dd35a65cbb103c6c70fdd6908b0a3195ef95 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 15 Aug 2026 16:30:50 +0000
Subject: [PATCH] core: wrap-safe reliable acks, and stop racing on the
 connection state
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Two defects in the PRUDP layer every game server shares.

1. Sequence-id wraparound in ackPackets. Reliable ids are 16 bits and
   outReliable wraps; the comparison was 'pid <= base', so everything still
   pending from before the wrap compared GREATER than every id after it and was
   never acknowledged. retransmitLoop then re-sent those packets every 2 s for
   the rest of the connection, the pending map never shrank, and the console
   kept receiving duplicates of messages it had already processed. A session
   that sends 65k reliable packets is ordinary for a lobby that stays up (each
   large DataStore payload is 13 of them). Fixed with the standard wrap-safe
   comparison int16(pid-base) <= 0.

2. Connection.state was a plain int written by the receive goroutine
   (processCONNECT) and by the transport (Close), and read by the retransmit
   loop and the paced multi-fragment sender. That is a data race, and its
   practical effect is writes to a closed connection. It is now an
   atomic.Int32, and close() uses CompareAndSwap so OnDisconnect runs EXACTLY
   once — it drops the player's lobbies, and running it twice removed a
   gathering a reconnecting player had just created.

Tests: an ack across the wrap clears the pending pool; an ack does NOT clear
packets the console has not seen (a genuinely lost fragment must still be
retransmitted); MULTI-ACK extras are honoured; eight concurrent Close calls run
OnDisconnect once. Verified with -race.
---
 ack_wraparound_test.go | 99 ++++++++++++++++++++++++++++++++++++++++++
 endpoint.go            | 38 ++++++++++++----
 endpoint_test.go       |  2 +-
 3 files changed, 129 insertions(+), 10 deletions(-)
 create mode 100644 ack_wraparound_test.go

diff --git a/ack_wraparound_test.go b/ack_wraparound_test.go
new file mode 100644
index 0000000..1a9acc3
--- /dev/null
+++ b/ack_wraparound_test.go
@@ -0,0 +1,99 @@
+package nex
+
+import (
+	"sync"
+	"testing"
+)
+
+// TestAckWraparound freezes the sequence-id wraparound fix.
+//
+// Reliable sequence ids are 16 bits and outReliable wraps after 65535. Before the fix
+// ackPackets compared `pid <= base`, so everything still pending from before the wrap
+// compared GREATER than every id after it and was never acknowledged: retransmitLoop
+// re-sent those packets every 2 s for the rest of the connection, the pending map never
+// shrank, and the console kept receiving duplicates of messages it had already processed.
+func TestAckWraparound(t *testing.T) {
+	c := &Connection{pending: map[uint16][]byte{}}
+
+	// Packets sent just before and just after the wrap.
+	for _, id := range []uint16{65530, 65531, 65534, 65535, 0, 1, 2} {
+		c.pending[id] = []byte("payload")
+	}
+
+	// The console acknowledges up to id 2 — i.e. everything above, across the wrap.
+	c.ackPackets(2, nil)
+
+	if len(c.pending) != 0 {
+		left := make([]uint16, 0, len(c.pending))
+		for id := range c.pending {
+			left = append(left, id)
+		}
+		t.Fatalf("%d packet(s) still pending after an ack across the wrap: %v", len(c.pending), left)
+	}
+}
+
+// TestAckDoesNotDropFuturePackets: the window comparison must not acknowledge packets the
+// console has NOT seen yet, or a genuinely lost fragment would never be retransmitted.
+func TestAckDoesNotDropFuturePackets(t *testing.T) {
+	c := &Connection{pending: map[uint16][]byte{}}
+	for _, id := range []uint16{10, 11, 12, 13} {
+		c.pending[id] = []byte("payload")
+	}
+	c.ackPackets(11, nil)
+	if _, ok := c.pending[12]; !ok {
+		t.Error("packet 12 was acknowledged although the console only acked up to 11")
+	}
+	if _, ok := c.pending[13]; !ok {
+		t.Error("packet 13 was acknowledged although the console only acked up to 11")
+	}
+	if _, ok := c.pending[10]; ok {
+		t.Error("packet 10 is still pending although it is behind the ack")
+	}
+}
+
+// TestExtraAcksAreHonoured covers the MULTI-ACK extra list.
+func TestExtraAcksAreHonoured(t *testing.T) {
+	c := &Connection{pending: map[uint16][]byte{}}
+	for _, id := range []uint16{20, 21, 22, 23} {
+		c.pending[id] = []byte("payload")
+	}
+	c.ackPackets(20, []uint16{22})
+	if _, ok := c.pending[22]; ok {
+		t.Error("an individually acknowledged packet is still pending")
+	}
+	if _, ok := c.pending[21]; !ok {
+		t.Error("packet 21 was dropped although it was neither behind the base nor in the extras")
+	}
+}
+
+// TestCloseRunsOnDisconnectOnce: the transport closing a socket and the receive goroutine
+// handling a DISCONNECT can race. OnDisconnect drops the player's lobbies, so running it
+// twice removed a gathering a reconnecting player had just created.
+func TestCloseRunsOnDisconnectOnce(t *testing.T) {
+	var mu sync.Mutex
+	calls := 0
+	e := NewEndpoint(NewSwitchSettings("00000000", 40000))
+	e.OnDisconnect = func(*Connection) {
+		mu.Lock()
+		calls++
+		mu.Unlock()
+	}
+	c := NewConnection(e, "127.0.0.1:1234", func([]byte) {})
+	c.state.Store(stateConnected)
+
+	var wg sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			c.Close()
+		}()
+	}
+	wg.Wait()
+
+	mu.Lock()
+	defer mu.Unlock()
+	if calls != 1 {
+		t.Fatalf("OnDisconnect ran %d times, want exactly 1", calls)
+	}
+}
